<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>

    <AssemblyName>SmartCalculator</AssemblyName>
    <Title>SmartCalculator</Title>
    <Product>SmartCalculator</Product>
    <Description>A premium handheld-style scientific calculator for Windows.</Description>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <InformationalVersion>3.0.0</InformationalVersion>
    <Authors>Ahmad Ibrahim</Authors>
    <Copyright>Copyright © 2026 Ahmad Ibrahim</Copyright>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test-runners\**" />
  </ItemGroup>
</Project>
