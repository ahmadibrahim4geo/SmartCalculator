<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SmartCalculator.ViewModels">

    <!-- Default skin metrics. The selected skin overrides these resources at runtime. -->
    <CornerRadius x:Key="SkinKeyCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SkinInnerCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SkinOvalCornerRadius">15</CornerRadius>
    <CornerRadius x:Key="SkinNavigatorCornerRadius">36</CornerRadius>
    <CornerRadius x:Key="SkinNavigatorButtonCornerRadius">18</CornerRadius>
    <Thickness x:Key="SkinKeyBorderThickness">1</Thickness>
    <Thickness x:Key="SkinInnerBorderThickness">1</Thickness>
    <Thickness x:Key="SkinNavigatorBorderThickness">1</Thickness>
    <Thickness x:Key="SkinKeyMargin">1.5</Thickness>
    <SolidColorBrush x:Key="SkinHighlightBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="SkinBevelBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="SkinNavigatorOverlayBrush" Color="#0EFFFFFF"/>
    <sys:Double x:Key="SkinHighlightHeight" xmlns:sys="clr-namespace:System;assembly=System.Runtime">14</sys:Double>
    <sys:Double x:Key="SkinKeyStrokeWidth" xmlns:sys="clr-namespace:System;assembly=System.Runtime">1</sys:Double>
    <sys:Double x:Key="SkinInnerStrokeWidth" xmlns:sys="clr-namespace:System;assembly=System.Runtime">1</sys:Double>
    <StreamGeometry x:Key="SkinKeyGeometry">M8,0 H92 Q100,0 100,8 V52 Q100,60 92,60 H8 Q0,60 0,52 V8 Q0,0 8,0 Z</StreamGeometry>
    <StreamGeometry x:Key="SkinNavigatorGeometry">M36,0 H86 C106,0 122,16 122,36 C122,56 106,72 86,72 H36 C16,72 0,56 0,36 C0,16 16,0 36,0 Z</StreamGeometry>
    <DropShadowEffect x:Key="SkinKeyEffect" BlurRadius="2" ShadowDepth="1"
                      Color="#000000" Opacity="0.28" Direction="270"/>
    <DropShadowEffect x:Key="SkinLabelShadow" BlurRadius="2" ShadowDepth="1"
                      Color="#000000" Opacity="0.95" Direction="270"/>

    <Style x:Key="KeyBaseStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource KeyTextBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SkinKeyBorderThickness}"/>
        <Setter Property="Margin" Value="{DynamicResource SkinKeyMargin}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Effect" Value="{DynamicResource SkinKeyEffect}"/>
    </Style>

    <ControlTemplate x:Key="CalculatorKeyTemplate" TargetType="Button">
        <Grid x:Name="keyRoot">
            <!-- 1. Key Face with active skin geometry -->
            <Path x:Name="keyFace" Data="{DynamicResource SkinKeyGeometry}"
                  Stretch="Fill" Fill="{TemplateBinding Background}"
                  Stroke="{TemplateBinding BorderBrush}"
                  StrokeThickness="{DynamicResource SkinKeyStrokeWidth}"/>

            <!-- 2. Subtle interior bevel -->
            <Path Data="{DynamicResource SkinKeyGeometry}" Stretch="Fill"
                  Fill="Transparent" Stroke="{DynamicResource SkinBevelBrush}"
                  StrokeThickness="{DynamicResource SkinInnerStrokeWidth}"
                  Margin="1.5" IsHitTestVisible="False"/>

            <!-- 3. Natural top light sheen -->
            <Border CornerRadius="{DynamicResource SkinInnerCornerRadius}"
                    Height="{DynamicResource SkinHighlightHeight}"
                    VerticalAlignment="Top" Margin="3,1.5,3,0"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 4. Key labels: 5px margin guarantees SHIFT & ALPHA labels are never clipped -->
            <Grid Margin="5,1,5,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Path=(vm:ButtonExtensions.SecondaryLabel), RelativeSource={RelativeSource TemplatedParent}}"
                               Foreground="{DynamicResource ShiftLabelBrush}"
                               Effect="{StaticResource SkinLabelShadow}"
                               FontSize="7" FontWeight="ExtraBold"
                               HorizontalAlignment="Left" Margin="0,1,0,0"
                               TextWrapping="NoWrap" TextTrimming="None"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Path=(vm:ButtonExtensions.AlphaLabel), RelativeSource={RelativeSource TemplatedParent}}"
                               Foreground="{DynamicResource AlphaLabelBrush}"
                               Effect="{StaticResource SkinLabelShadow}"
                               FontSize="7" FontWeight="ExtraBold"
                               HorizontalAlignment="Right" Margin="0,1,0,0"
                               TextWrapping="NoWrap" TextTrimming="None"/>
                </Grid>
                <ContentPresenter Grid.Row="1" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" RecognizesAccessKey="False"
                                  Margin="0,0,0,1"/>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="keyFace" Property="Opacity" Value="0.86"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                </Setter>
                <Setter TargetName="keyRoot" Property="Opacity" Value="0.74"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="SimpleKeyTemplate" TargetType="Button">
        <Grid x:Name="keyRoot">
            <Path x:Name="keyFace" Data="{DynamicResource SkinKeyGeometry}"
                  Stretch="Fill" Fill="{TemplateBinding Background}"
                  Stroke="{TemplateBinding BorderBrush}"
                  StrokeThickness="{DynamicResource SkinKeyStrokeWidth}"/>
            <Path Data="{DynamicResource SkinKeyGeometry}" Stretch="Fill"
                  Fill="Transparent" Stroke="{DynamicResource SkinBevelBrush}"
                  StrokeThickness="{DynamicResource SkinInnerStrokeWidth}"
                  Margin="1.5" IsHitTestVisible="False"/>
            <Border CornerRadius="{DynamicResource SkinInnerCornerRadius}"
                    Height="{DynamicResource SkinHighlightHeight}"
                    VerticalAlignment="Top" Margin="3,1.5,3,0"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="False" Margin="0,1"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="keyFace" Property="Opacity" Value="0.86"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                </Setter>
                <Setter TargetName="keyRoot" Property="Opacity" Value="0.74"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="OvalButtonTemplate" TargetType="Button">
        <Grid Width="45" Height="30">
            <Border x:Name="keyFace"
                    CornerRadius="{DynamicResource SkinOvalCornerRadius}"
                    Background="{DynamicResource NavyKeyGradient}"
                    BorderBrush="{DynamicResource NavyBorderBrush}"
                    BorderThickness="{DynamicResource SkinKeyBorderThickness}">
                <Grid>
                    <Border CornerRadius="{DynamicResource SkinOvalCornerRadius}"
                            Height="{DynamicResource SkinHighlightHeight}"
                            VerticalAlignment="Top" Margin="2,1,2,0" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#28FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RecognizesAccessKey="False"/>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="keyFace" Property="Opacity" Value="0.86"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                </Setter>
                <Setter TargetName="keyFace" Property="Opacity" Value="0.70"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ScienceKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyBaseStyle}">
        <Setter Property="Template" Value="{StaticResource CalculatorKeyTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource ScienceKeyGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ScienceBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource KeyTextBrush}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style x:Key="NumberKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyBaseStyle}">
        <Setter Property="Template" Value="{StaticResource CalculatorKeyTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource NumberKeyGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NumberBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource NumberTextBrush}"/>
        <Setter Property="FontSize" Value="23"/>
    </Style>
    <Style x:Key="OperatorKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyBaseStyle}">
        <Setter Property="Template" Value="{StaticResource CalculatorKeyTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource OperatorKeyGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}"/>
        <Setter Property="FontSize" Value="23"/>
    </Style>
    <Style x:Key="ControlKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyBaseStyle}">
        <Setter Property="Template" Value="{StaticResource CalculatorKeyTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource ControlKeyGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OrangeBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OrangeTextBrush}"/>
        <Setter Property="FontSize" Value="19"/>
    </Style>
    <Style x:Key="OvalKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyBaseStyle}">
        <Setter Property="Template" Value="{StaticResource OvalButtonTemplate}"/>
        <Setter Property="Effect" Value="{DynamicResource SkinKeyEffect}"/>
    </Style>
    <Style x:Key="SimpleScienceKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyBaseStyle}">
        <Setter Property="Template" Value="{StaticResource SimpleKeyTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource ScienceKeyGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ScienceBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource KeyTextBrush}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="DpadOuterStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource SkinNavigatorCornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NavyBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SkinNavigatorBorderThickness}"/>
        <Setter Property="Background" Value="{DynamicResource NavyKeyGradient}"/>
        <Setter Property="Effect" Value="{DynamicResource SkinKeyEffect}"/>
    </Style>

    <Style x:Key="DpadButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource KeyTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="Transparent"
                            CornerRadius="{DynamicResource SkinNavigatorButtonCornerRadius}"
                            Padding="6,4">
                        <ContentPresenter x:Name="content" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource SkinNavigatorOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#38FFFFFF"/>
                            <Setter TargetName="content" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.84" ScaleY="0.84"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Tag" Value="KeyboardPressed">
                            <Setter TargetName="btnBorder" Property="Background" Value="#38FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DpadCenterButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SkinNavigatorOverlayBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource SkinInnerBorderThickness}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SkinBevelBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource SkinNavigatorButtonCornerRadius}">
                        <Grid>
                            <Border CornerRadius="{DynamicResource SkinNavigatorButtonCornerRadius}"
                                    Height="14" VerticalAlignment="Top" Margin="2,1" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#38FFFFFF"/>
                            <Setter TargetName="content" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.88" ScaleY="0.88"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Tag" Value="KeyboardPressed">
                            <Setter Property="Background" Value="#38FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
